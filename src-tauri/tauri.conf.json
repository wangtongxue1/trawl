{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trawl",
  "version": "0.7.13",
  "identifier": "com.trawl.browser",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/trawl.ico",
      "icons/trawl-icon-128.png",
      "icons/trawl-icon-32.png"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
