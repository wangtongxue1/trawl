{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trawl",
  "version": "0.7.18",
  "identifier": "com.trawl.browser",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/trawl.ico",
      "icons/icon.icns",
      "icons/trawl-icon-128.png",
      "icons/trawl-icon-32.png"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "installerIcon": "icons/trawl.ico",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}